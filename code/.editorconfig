# EditorConfig — https://editorconfig.org/
# Keeps line-endings, indentation and final newlines consistent across IDEs.

root = true

# Default for every text file
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4
max_line_length          = 100

# ─── Python (matches black + isort line-length) ───
[*.py]
indent_size              = 4

# ─── Web frontend ───
[*.{ts,tsx,js,jsx}]
indent_size              = 2

[*.{vue,html,css,scss,less}]
indent_size              = 2

# ─── Markdown allows trailing whitespace (line-break syntax) ───
[*.md]
trim_trailing_whitespace = false

# ─── Data formats ───
[*.{yml,yaml,toml,json}]
indent_size              = 2

# ─── Makefiles MUST use tabs ───
[{Makefile,Snakefile,Dockerfile,Dockerfile.*}]
indent_style             = tab

# ─── Windows scripts keep CRLF ───
[*.{bat,cmd,ps1}]
end_of_line              = crlf
