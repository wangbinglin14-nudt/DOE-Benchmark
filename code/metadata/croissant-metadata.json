  "@type": "sc:Dataset",
  "name": "DOE-Benchmark headline benchmark archive",
  "description": "Machine-readable Croissant metadata for the DOE-Benchmark Communications Engineering submission package. The archive contains the frozen 34-case x 20-method x 4-budget x 30-repeat row-level benchmark results, run manifest, figure data, paper numbers, supplementary materials, command history, source fingerprints, and case-validation evidence.",
  "license": "https://spdx.org/licenses/MIT",
  "version": "0.4.0-dev",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Binglin Wang",
      "affiliation": "National University of Defense Technology (NUDT), China"
    }
  ],
  "keywords": [
    "design of experiments",
    "surrogate modeling",
    "Bayesian optimization",
    "physics-grounded benchmark",
    "scientific computing",
    "reproducibility"
  ],
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "headline_results_csv",
      "name": "results.csv",
      "contentUrl": "benchmark/results/full_benchmark/results.csv",
      "encodingFormat": "text/csv",
      "description": "Canonical row-level 34-case x 20-method x 4-budget x 30-repeat headline result table generated on the Linux server."
    },
    {
      "@type": "cr:FileObject",
      "@id": "run_manifest_json",
      "name": "RUN_MANIFEST.json",
      "contentUrl": "benchmark/results/full_benchmark/RUN_MANIFEST.json",
      "encodingFormat": "application/json",
      "description": "Machine-readable provenance, environment, command-history, source-hash, result-summary, and artifact-hash manifest."
    },
    {
      "@type": "cr:FileObject",
      "@id": "figdata_manifest_json",
      "name": "figdata_manifest.json",
      "contentUrl": "paper/figdata/figdata_manifest.json",
      "encodingFormat": "application/json",
      "description": "Figure-data lineage manifest derived from the canonical results.csv and downstream D1/D2/D3 analyses."
    }
  ],
